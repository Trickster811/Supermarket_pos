generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  CASHIER
}

enum SellingMode {
  UNIT
  WEIGHT
}

enum UnitOfMeasure {
  PIECE
  PACKET
  BOTTLE
  BOX
  KG
  GRAM
  LITRE
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

enum InventoryMovementType {
  OPENING_STOCK
  STOCK_IN
  SALE
  RETURN
  SPOILAGE
  ADJUSTMENT
  VOID_REVERSAL
}

enum StockReceiptStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

enum PrintAttemptStatus {
  QUEUED
  SUCCESS
  FAILED
}

enum SyncDirection {
  PUSH
  PULL
  BIDIRECTIONAL
}

enum SyncStatus {
  STARTED
  SUCCESS
  PARTIAL
  FAILED
}

model User {
  id                   String                @id @default(uuid()) @db.Uuid
  fullName             String
  username             String                @unique
  passwordHash         String
  role                 UserRole              @default(CASHIER)
  isActive             Boolean               @default(true)
  sales                Sale[]
  inventoryMovements   InventoryMovement[]
  stockReceipts        StockReceipt[]
  receiptPrintAttempts ReceiptPrintAttempt[]
  auditLogs            AuditLog[]
  tokenVersion         Int                   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@map("users")
}

model Terminal {
  id                   String                @id @default(uuid()) @db.Uuid
  terminalCode         String                @unique
  name                 String
  deviceUuid           String?               @unique @db.Uuid
  isActive             Boolean               @default(true)
  lastSeenAt           DateTime?
  sales                Sale[]
  inventoryMovements   InventoryMovement[]
  stockReceipts        StockReceipt[]
  receiptPrintAttempts ReceiptPrintAttempt[]
  syncLogs             SyncLog[]
  syncState            TerminalSyncState?
  auditLogs            AuditLog[]

  // Secure device pairing
  pairingCodeHash    String?
  pairingExpiresAt   DateTime?
  deviceTokenHash    String?
  pairedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("terminals")
}

model Category {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  description String?
  isActive    Boolean @default(true)

  // Allows categories and subcategories.
  parentId String?    @db.Uuid
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([parentId])
  @@map("categories")
}

model Product {
  id String @id @default(uuid()) @db.Uuid

  // Internal product identifier.
  sku String @unique

  name        String
  description String?

  // Barcode for packaged products.
  barcode String? @unique

  // PLU code for products selected manually.
  pluCode String? @unique

  sellingMode   SellingMode
  unitOfMeasure UnitOfMeasure

  // XAF (FCFA). For WEIGHT products,
  // this is the price per unit of measure.
  price Decimal @db.Decimal(14, 2)

  isActive       Boolean @default(true)
  trackInventory Boolean @default(true)

  categoryId         String?             @db.Uuid
  category           Category?           @relation(fields: [categoryId], references: [id])
  saleItems          SaleItem[]
  inventory          Inventory?
  inventoryMovements InventoryMovement[]
  stockReceiptItems  StockReceiptItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([categoryId])
  @@index([sellingMode])
  @@map("products")
}

model Sale {
  id String @id @default(uuid()) @db.Uuid

  // Unique transaction identifier generated by the phone.
  // Important for preventing duplicate offline sales.
  transactionUuid String @unique @db.Uuid

  cashierId  String @db.Uuid
  terminalId String @db.Uuid

  cashier  User     @relation(fields: [cashierId], references: [id])
  terminal Terminal @relation(fields: [terminalId], references: [id])

  totalAmount  Decimal @db.Decimal(14, 2)
  currencyCode String  @default("XAF") @db.VarChar(3)

  status SaleStatus @default(COMPLETED)

  // Time when the transaction was created on the smartphone.
  deviceCreatedAt DateTime

  // Time when the server received the transaction.
  createdAt DateTime @default(now())

  items   SaleItem[]
  receipt Receipt?

  @@index([cashierId])
  @@index([terminalId])
  @@index([createdAt])
  @@index([status])
  @@map("sales")
}

model SaleItem {
  id String @id @default(uuid()) @db.Uuid

  saleId    String @db.Uuid
  productId String @db.Uuid

  sale    Sale    @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  // Historical product information.
  productName   String
  unitOfMeasure UnitOfMeasure

  quantity           Decimal             @db.Decimal(14, 3)
  unitPrice          Decimal             @db.Decimal(14, 2)
  subtotal           Decimal             @db.Decimal(14, 2)
  inventoryMovements InventoryMovement[]

  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model Inventory {
  id        String @id @default(uuid()) @db.Uuid
  productId String @unique @db.Uuid

  product Product @relation(fields: [productId], references: [id])

  quantity Decimal @default(0) @db.Decimal(14, 3)

  updatedAt DateTime @updatedAt

  @@map("inventory")
}

model InventoryMovement {
  id String @id @default(uuid()) @db.Uuid

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  movementType   InventoryMovementType
  quantityChange Decimal               @db.Decimal(14, 3)

  // Optional reference to the sale item that caused this movement.
  saleItemId String?   @db.Uuid
  saleItem   SaleItem? @relation(fields: [saleItemId], references: [id])

  // Who performed the operation?
  performedById String? @db.Uuid
  performedBy   User?   @relation(fields: [performedById], references: [id])

  // Which checkout terminal recorded it?
  terminalId String?   @db.Uuid
  terminal   Terminal? @relation(fields: [terminalId], references: [id])

  reason             String?
  stockReceiptItemId String?           @unique @db.Uuid
  stockReceiptItem   StockReceiptItem? @relation(fields: [stockReceiptItemId], references: [id])

  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([movementType])
  @@index([saleItemId])
  @@index([performedById])
  @@index([terminalId])
  @@map("inventory_movements")
}

model StockReceipt {
  id            String @id @default(uuid()) @db.Uuid
  receiptNumber String @unique

  supplierName      String?
  supplierReference String?

  status StockReceiptStatus @default(DRAFT)

  receivedById String? @db.Uuid
  receivedBy   User?   @relation(fields: [receivedById], references: [id])

  terminalId String?   @db.Uuid
  terminal   Terminal? @relation(fields: [terminalId], references: [id])

  receivedAt DateTime?
  notes      String?

  items StockReceiptItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([receivedAt])
  @@map("stock_receipts")
}

model StockReceiptItem {
  id String @id @default(uuid()) @db.Uuid

  stockReceiptId String       @db.Uuid
  stockReceipt   StockReceipt @relation(fields: [stockReceiptId], references: [id])

  productId String  @db.Uuid
  product   Product @relation(fields: [productId], references: [id])

  // Historical product information at the time of receipt.
  productName   String
  unitOfMeasure UnitOfMeasure

  quantity  Decimal @db.Decimal(14, 3)
  unitCost  Decimal @db.Decimal(14, 2)
  totalCost Decimal @db.Decimal(14, 2)

  inventoryMovement InventoryMovement?

  createdAt DateTime @default(now())

  @@index([stockReceiptId])
  @@index([productId])
  @@map("stock_receipt_items")
}

model Receipt {
  id            String @id @default(uuid()) @db.Uuid
  receiptNumber String @unique

  saleId String @unique @db.Uuid
  sale   Sale   @relation(fields: [saleId], references: [id])

  // Snapshot of the document as it was issued.
  content Json

  issuedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  printAttempts ReceiptPrintAttempt[]

  @@index([issuedAt])
  @@map("receipts")
}

model ReceiptPrintAttempt {
  id String @id @default(uuid()) @db.Uuid

  receiptId String  @db.Uuid
  receipt   Receipt @relation(fields: [receiptId], references: [id])

  attemptNumber Int

  status PrintAttemptStatus @default(QUEUED)

  // Printer identification without assuming a connection type.
  printerName String?
  printerId   String?

  // Who requested printing?
  requestedById String? @db.Uuid
  requestedBy   User?   @relation(fields: [requestedById], references: [id])

  // Which checkout terminal requested it?
  terminalId String?   @db.Uuid
  terminal   Terminal? @relation(fields: [terminalId], references: [id])

  errorMessage String?

  attemptedAt DateTime  @default(now())
  completedAt DateTime?

  @@unique([receiptId, attemptNumber])
  @@index([status])
  @@index([attemptedAt])
  @@index([terminalId])
  @@map("receipt_print_attempts")
}

model SyncLog {
  id String @id @default(uuid()) @db.Uuid

  terminalId String   @db.Uuid
  terminal   Terminal @relation(fields: [terminalId], references: [id])

  direction SyncDirection
  status    SyncStatus    @default(STARTED)

  recordsSent     Int @default(0)
  recordsReceived Int @default(0)
  recordsFailed   Int @default(0)

  errorMessage String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([terminalId, startedAt])
  @@index([status])
  @@map("sync_logs")
}

model TerminalSyncState {
  id String @id @default(uuid()) @db.Uuid

  terminalId String   @unique @db.Uuid
  terminal   Terminal @relation(fields: [terminalId], references: [id])

  lastAttemptAt        DateTime?
  lastSuccessfulSyncAt DateTime?
  lastSuccessfulPushAt DateTime?
  lastSuccessfulPullAt DateTime?

  lastErrorMessage String?

  updatedAt DateTime @updatedAt

  @@map("terminal_sync_states")
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id])

  terminalId String?   @db.Uuid
  terminal   Terminal? @relation(fields: [terminalId], references: [id])

  action     String
  entityType String?
  entityId   String? @db.Uuid

  details Json?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([terminalId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
  @@map("audit_logs")
}
